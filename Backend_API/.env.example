# Production environment variables for ROKIKA SHOP
# Copy this file to .env and fill in real values before deploying.

# App
APP_NAME=ROKIKA SHOP API
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Database (PostgreSQL on Supabase/Neon/Render)
DATABASE_URL=postgresql://user:password@host:5432/rokikadb

# CORS (frontend URLs that can call this API)
CORS_ORIGINS=https://rokika-shop.netlify.app,https://dashboard.rokika-shop.netlify.app,https://telegram.rokika-shop.netlify.app

# URLs
STORE_URL=https://rokika-shop.netlify.app
API_URL=https://rokika-api.onrender.com

# Admin bootstrap
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=change-me-admin-password

# ABA Pay (leave empty until configured)
ABA_MERCHANT_ID=
ABA_ACCESS_TOKEN=
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Platform shop (collects plan payments)
PLATFORM_SHOP_USERNAME=demo

# Reseller / referral
REFERRAL_SECRET=change-me-to-a-random-string